# Public URL where Jamify is reached (used for Spotify OAuth callbacks and cookies)
# For local dev, Spotify requires 127.0.0.1 rather than localhost.
APP_URL=http://127.0.0.1:3000

# Path to the SQLite database file
DATABASE_PATH=./data/jamify.db

# Google Gemini API key (server-side only; never exposed to the browser)
GEMINI_API_KEY=your_gemini_api_key

# Spotify Developer App credentials (server-side only)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Random 32+ character secret used to sign sessions and encrypt stored tokens
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_hex_secret

# Optional comma-separated Spotify user IDs allowed to access this instance
# Leave empty to allow any authenticated Spotify user (not recommended for public URLs)
ALLOWED_SPOTIFY_USER_IDS=your_spotify_user_id
