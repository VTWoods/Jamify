# Copy this file to .env alongside docker-compose.yml and fill in your real values.
# Never commit your populated .env file.

APP_URL=https://jamify.example.com
DATABASE_PATH=/data/jamify.db

GEMINI_API_KEY=your_gemini_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_hex_secret

# Comma-separated Spotify user IDs permitted to use this instance
ALLOWED_SPOTIFY_USER_IDS=your_spotify_user_id
